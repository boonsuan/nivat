@[reducible] def Nivat.Lattice : Type :=
ℤ × ℤ
@[reducible] def Nivat.Configuration.{u_1} : Type u_1 → Type u_1 :=
fun A => Nivat.Lattice → A
def Nivat.FiniteRange.{u_1} : {A : Type u_1} → Nivat.Configuration A → Prop :=
fun {A} c => (Set.range c).Finite
def Nivat.shift.{u_1} : {A : Type u_1} → Nivat.Lattice → Nivat.Configuration A → Nivat.Configuration A :=
fun {A} h c z => c (z + h)
def Nivat.difference.{u_1} : {A : Type u_1} →
  [AddCommGroup A] → Nivat.Lattice → Nivat.Configuration A → Nivat.Configuration A :=
fun {A} [AddCommGroup A] h c => Nivat.shift h c - c
def Nivat.Periodic.{u_1} : {A : Type u_1} → Nivat.Configuration A → Prop :=
fun {A} c => ∃ h, h ≠ 0 ∧ Nivat.IsPeriod c h
def Nivat.IsPeriod.{u_1} : {A : Type u_1} → Nivat.Configuration A → Nivat.Lattice → Prop :=
fun {A} c h => ∀ (z : Nivat.Lattice), c (z + h) = c z
def Nivat.patternAt.{u_1} : {A : Type u_1} →
  Nivat.Configuration A → (D : Finset Nivat.Lattice) → Nivat.Lattice → ↥D → A :=
fun {A} c D u z => c (↑z + u)
def Nivat.patterns.{u_1} : {A : Type u_1} → Nivat.Configuration A → (D : Finset Nivat.Lattice) → Set (↥D → A) :=
fun {A} c D => Set.range (Nivat.patternAt c D)
def Nivat.complexity.{u_1} : {A : Type u_1} → Nivat.Configuration A → Finset Nivat.Lattice → ℕ :=
fun {A} c D => (Nivat.patterns c D).ncard
def Nivat.rectangle : ℕ → ℕ → Finset Nivat.Lattice :=
fun m n => (Finset.Ico 0 ↑m).product (Finset.Ico 0 ↑n)
